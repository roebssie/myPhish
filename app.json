{
  "expo": {
    "name": "myPhish",
    "slug": "myphish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/myphish-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.myphish"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#083F4B",
        "foregroundImage": "./assets/myphish-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/myphish-icon.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
